---
---
<section class="hero section">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="eyebrow hero-anim">100% local · sin backend · sin subir tu video</span>
      <h1 class="title hero-anim">Convierte video en <span class="grad">frames</span>.</h1>
      <p class="lead hero-anim">
        Frameo separa tu video en imágenes ordenadas, directamente en tu navegador. Cargas, procesas y descargas un <strong>.zip</strong> con nombres como <code>frame_00001.png</code>. Tu archivo nunca sale de tu computador.
      </p>
      <div class="hero-actions hero-anim">
        <a href="/app" class="btn btn-primary">
          Empezar a convertir
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="#como-funciona" class="btn btn-ghost">Ver cómo funciona</a>
      </div>
      <div class="hero-proof hero-anim">
        <div class="proof-item"><span class="dot"></span><div><strong>Privacidad real</strong><small>Procesamiento en tu navegador</small></div></div>
        <div class="proof-item"><span class="dot"></span><div><strong>Orden perfecto</strong><small>Frames numerados con padding</small></div></div>
        <div class="proof-item"><span class="dot"></span><div><strong>ZIP listo</strong><small>Descarga directa al terminar</small></div></div>
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="visual-glow"></div>
      <iframe class="anim-main" src="/frameo-hero-animacion.html" title="Animación: video a frames a zip" loading="eager"></iframe>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce) {
    gsap.from('.hero-anim', { y: 28, opacity: 0, duration: 0.9, stagger: 0.12, ease: 'power3.out', delay: 1.7 });
    gsap.from('.anim-main', { scale: 0.94, opacity: 0, duration: 1.1, ease: 'power3.out', delay: 1.9 });
  }
</script>

<style>
  .hero { padding: 4rem 0 2rem; position: relative; overflow: clip; }
  .hero-bg {
    position: absolute; inset: -10% -20% auto; height: 80%; pointer-events: none;
    background: radial-gradient(ellipse at 60% 30%, rgba(0,245,212,.12), transparent 45%),
                radial-gradient(ellipse at 80% 20%, rgba(198,255,61,.08), transparent 35%);
  }
  .hero-grid { display: grid; grid-template-columns: minmax(0,.95fr) minmax(0,1.05fr); gap: 2rem; align-items: center; position: relative; }
  .hero-copy .lead strong { color: #fff; }
  .hero-copy code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .92em;
    padding: .15rem .45rem; border-radius: 8px; background: rgba(255,255,255,.07); color: #d7fff7;
  }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .9rem; margin: 1.8rem 0 2rem; }
  .hero-proof { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: .9rem; }
  .proof-item { display: flex; gap: .7rem; align-items: flex-start; padding: .9rem 0; border-top: 1px solid rgba(255,255,255,.08); }
  .dot { width: 8px; height: 8px; margin-top: .45rem; border-radius: 50%; background: linear-gradient(135deg, var(--mint), var(--lime)); box-shadow: 0 0 0 4px rgba(0,245,212,.12); flex-shrink: 0; }
  .proof-item strong { display: block; font-size: .88rem; margin-bottom: .15rem; }
  .proof-item small { color: rgba(255,255,255,.58); font-size: .76rem; line-height: 1.35; }

  .hero-visual { position: relative; min-height: 640px; }
  .visual-glow {
    position: absolute; inset: 8% 0 15%; border-radius: 50%;
    background: radial-gradient(circle, rgba(0,245,212,.14), rgba(198,255,61,.05) 45%, transparent 72%);
    filter: blur(8px); pointer-events: none;
  }
  .hero-visual iframe {
    position: absolute; border: 0; background: transparent; display: block; overflow: hidden;
  }
  .anim-main {
    width: min(100%, 660px); height: 660px; left: 50%; top: 50%; transform: translate(-50%, -50%);
    filter: drop-shadow(0 24px 70px rgba(0,245,212,.1));
  }

  @media (max-width: 1050px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-visual { min-height: 560px; max-width: 760px; width: 100%; margin-inline: auto; }
    .title { max-width: 12ch; }
  }
  @media (max-width: 720px) {
    .hero { padding-top: 2.5rem; }
    .hero-proof { grid-template-columns: 1fr; gap: 0; }
    .hero-visual { min-height: 420px; }
    .anim-main { width: 115%; height: 440px; }
  }
</style>
