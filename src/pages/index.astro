---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import MetaballLoader from '../components/MetaballLoader.astro';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Frameo',
    url: 'https://frameo.app/',
    description: 'Convierte videos en frames ordenados y descárgalos en ZIP. 100% local, sin subir archivos, sin backend.',
    inLanguage: 'es',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Frameo',
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Web',
    url: 'https://frameo.app/app',
    description: 'Herramienta web local para convertir video a frames y descargar un ZIP en el navegador.',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: '¿Frameo sube mi video a algún servidor?', acceptedAnswer: { '@type': 'Answer', text: 'No. El procesamiento ocurre en tu navegador. El archivo se queda en tu dispositivo.' } },
      { '@type': 'Question', name: '¿Qué recibo al finalizar?', acceptedAnswer: { '@type': 'Answer', text: 'Un archivo .zip con imágenes numeradas en orden, por ejemplo frame_00001.png.' } },
      { '@type': 'Question', name: '¿Qué formatos puedo elegir?', acceptedAnswer: { '@type': 'Answer', text: 'En el MVP: PNG para calidad sin pérdida y JPG para menor peso. También podrás elegir extraer todos los frames o uno cada X.' } },
      { '@type': 'Question', name: '¿Necesito crear cuenta?', acceptedAnswer: { '@type': 'Answer', text: 'No. Frameo funciona sin cuentas, sin login y sin backend.' } },
    ],
  },
];
---
<Layout
  title="Frameo — Convierte video a frames en tu navegador"
  description="Convierte videos en frames ordenados y descárgalos en ZIP. 100% local, sin subir archivos, sin backend."
  schema={schema}
>
  <Header />
  <main>
    <Hero />

    <section class="section" id="como-funciona">
      <div class="container">
        <span class="eyebrow">Cómo funciona</span>
        <h2 class="section-title">Tres pasos. <span class="grad-text">Cero subidas.</span></h2>
        <div class="steps-grid">
          <article class="step-card"><span class="step-num">01</span><h3>Carga tu video</h3><p>Selecciona o arrastra un archivo desde tu computador. Frameo lo lee localmente en el navegador.</p></article>
          <article class="step-card"><span class="step-num">02</span><h3>Extrae frames</h3><p>Elige PNG o JPG y la frecuencia de extracción. Verás el progreso mientras se procesan los cuadros.</p></article>
          <article class="step-card"><span class="step-num">03</span><h3>Descarga el ZIP</h3><p>Recibe un archivo con frames numerados: <code>frame_00001.png</code>, <code>frame_00002.png</code>, etc.</p></article>
        </div>
      </div>
    </section>

    <section class="section privacy" id="privacidad">
      <div class="container privacy-grid">
        <div>
          <span class="eyebrow">Privacidad local</span>
          <h2 class="section-title">Tu video no viaja. <span class="grad-text">Se queda contigo.</span></h2>
          <p class="lead">Frameo no tiene backend para procesar videos. La extracción ocurre en tu dispositivo, dentro del navegador. Esto reduce fricción, mejora la privacidad y evita subir archivos pesados.</p>
          <div class="privacy-points" id="formatos">
            <div class="point"><strong>PNG / JPG</strong><span>Calidad sin pérdida o archivos más livianos.</span></div>
            <div class="point"><strong>Todos o cada X</strong><span>Controla la frecuencia de extracción.</span></div>
            <div class="point"><strong>ZIP ordenado</strong><span>Nombres con padding para ordenar bien.</span></div>
          </div>
        </div>
        <div class="privacy-visual">
          <MetaballLoader size={220} label="Espacios de carga con procesamiento local" />
          <div class="local-badge">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3l7 3v5c0 5-3 7.5-7 10-4-2.5-7-5-7-10V6l7-3Z" stroke="currentColor" stroke-width="1.8"/><path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Sin subida de archivos
          </div>
        </div>
      </div>
    </section>

    <section class="showcase" id="animaciones">
      <div class="process-pin" id="process-pin">
        <div class="process-sticky">
          <div class="container process-layout">
            <div class="process-copy">
              <span class="eyebrow">El proceso</span>
              <h2 class="section-title">El proceso, <span class="grad-text">explicado visualmente.</span></h2>
              <div class="process-steps">
                <article class="process-step is-active" data-step="0">
                  <span class="step-num">01</span>
                  <div><h3>Del video al ZIP</h3><p>Cargas el video, Frameo extrae los frames y los empaqueta en un ZIP. Todo ocurre localmente en tu navegador.</p></div>
                </article>
                <article class="process-step" data-step="1">
                  <span class="step-num">02</span>
                  <div><h3>Escaneo frame por frame</h3><p>Cada momento del video se captura como una imagen numerada, creando una hoja de contactos ordenada.</p></div>
                </article>
                <article class="process-step" data-step="2">
                  <span class="step-num">03</span>
                  <div><h3>Frames listos para usar</h3><p>La tira se separa en cuadros individuales con nombres como <code>frame_00001.png</code>, listos para descargar.</p></div>
                </article>
              </div>
            </div>
            <div class="process-visual">
              <div class="process-stage">
                <iframe class="process-frame is-active" data-step="0" src="/frameo-hero-animacion.html" title="Video a frames y ZIP" loading="eager"></iframe>
                <iframe class="process-frame" data-step="1" src="/frameo-hoja-contactos.html" title="Hoja de contactos" loading="lazy"></iframe>
                <iframe class="process-frame" data-step="2" src="/frameo-tira-pelicula.html" title="Tira de película" loading="lazy"></iframe>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <script>
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      gsap.registerPlugin(ScrollTrigger);

      const pin = document.getElementById('process-pin');
      const steps = [...document.querySelectorAll('.process-step')];
      const frames = [...document.querySelectorAll('.process-frame')];
      const setStep = (i) => {
        steps.forEach((s, idx) => s.classList.toggle('is-active', idx === i));
        frames.forEach((f, idx) => f.classList.toggle('is-active', idx === i));
      };

      if (pin && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        ScrollTrigger.create({
          trigger: pin,
          start: 'top top',
          end: 'bottom bottom',
          scrub: true,
          onUpdate: (self) => {
            const p = Math.min(0.999, Math.max(0, self.progress));
            const i = Math.min(steps.length - 1, Math.floor(p * steps.length));
            setStep(i);
          },
        });
        setStep(0);
      }
    </script>

    <section class="section faq" id="faq">
      <div class="container faq-grid">
        <div>
          <span class="eyebrow">FAQ</span>
          <h2 class="section-title">Preguntas <span class="grad-text">rápidas.</span></h2>
          <p class="lead">Sin correo de soporte por ahora: aquí tienes la guía esencial para usar Frameo.</p>
          <a href="/app" class="btn btn-primary" style="margin-top:1.5rem;">Ir a la herramienta</a>
        </div>
        <div class="faq-list">
          <details open><summary>¿Frameo sube mi video a algún servidor?</summary><p>No. El procesamiento ocurre en tu navegador. El archivo se queda en tu dispositivo.</p></details>
          <details><summary>¿Qué recibo al finalizar?</summary><p>Un archivo <code>.zip</code> con imágenes numeradas en orden, por ejemplo <code>frame_00001.png</code>.</p></details>
          <details><summary>¿Qué formatos puedo elegir?</summary><p>En el MVP: PNG para calidad sin pérdida y JPG para menor peso. También podrás elegir extraer todos los frames o uno cada X.</p></details>
          <details><summary>¿Necesito crear cuenta?</summary><p>No. Frameo funciona sin cuentas, sin login y sin backend.</p></details>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <div>
        <img src="/logo.svg" alt="Frameo" width="140" height="42" />
        <p>Convierte video a frames. Local, simple y privado.</p>
      </div>
      <div class="footer-links">
        <a href="/#como-funciona">Cómo funciona</a>
        <a href="/#privacidad">Privacidad</a>
        <a href="/#faq">FAQ</a>
        <a href="/app">Abrir app</a>
      </div>
    </div>
  </footer>

</Layout>

<style>
  .section-title { font-size: clamp(2rem, 5vw, 3.6rem); line-height: 1.02; letter-spacing: -0.04em; margin: .8rem 0 1.2rem; max-width: 14ch; }
  .steps-grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 1rem; margin-top: 2rem; }
  .step-card, .privacy-visual, .faq-list details {
    background: linear-gradient(180deg, rgba(255,255,255,.09), rgba(255,255,255,.03));
    border: 1px solid rgba(255,255,255,.12); border-radius: 22px;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.14); backdrop-filter: blur(14px);
  }
  .step-card { padding: 1.4rem; }
  .step-num { display: inline-block; font-size: .8rem; font-weight: 700; color: #061014; background: var(--grad); padding: .35rem .65rem; border-radius: 999px; margin-bottom: 1rem; }
  .step-card h3 { margin: 0 0 .5rem; font-size: 1.15rem; }
  .step-card p, .point span, .faq-list p, .site-footer p { color: rgba(255,255,255,.7); line-height: 1.7; margin: 0; }
  .step-card code, .faq-list code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .92em; padding: .12rem .4rem; border-radius: 8px; background: rgba(255,255,255,.07); }
  .privacy-grid, .faq-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: center; }
  .privacy-points { display: grid; gap: .8rem; margin-top: 1.5rem; }
  .point { padding: 1rem 1.1rem; border-radius: 16px; background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.07); }
  .point strong { display: block; margin-bottom: .2rem; font-size: .95rem; }
  .privacy-visual { min-height: 360px; display: grid; place-items: center; align-content: center; gap: 1.5rem; padding: 2rem; background: radial-gradient(circle at top, rgba(0,245,212,.09), rgba(255,255,255,.02)); }
  .local-badge { display: inline-flex; align-items: center; gap: .55rem; padding: .7rem 1rem; border-radius: 999px; background: rgba(0,245,212,.08); border: 1px solid rgba(0,245,212,.18); color: #dffff7; font-weight: 600; font-size: .86rem; }
  .local-badge svg { color: var(--lime); }
  .showcase { position: relative; }
  .process-pin { height: 320vh; position: relative; }
  .process-sticky { position: sticky; top: 0; min-height: 100vh; display: flex; align-items: center; padding: 6rem 0; width: 100%; }
  .process-layout { display: grid; grid-template-columns: minmax(0,.88fr) minmax(0,1.12fr); gap: 3rem; align-items: center; width: 100%; }
  .process-copy .section-title { max-width: 12ch; margin-bottom: 2rem; }
  .process-steps { display: grid; gap: .75rem; }
  .process-step {
    display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: start;
    padding: 1rem 0 1rem 1rem; border-left: 1px solid rgba(255,255,255,.12);
    opacity: .38; transition: opacity .35s ease, border-color .35s ease, transform .35s ease;
  }
  .process-step.is-active { opacity: 1; border-color: rgba(0,245,212,.7); transform: translateX(4px); }
  .process-step .step-num { margin-top: .15rem; }
  .process-step h3 { margin: 0 0 .35rem; font-size: 1.25rem; letter-spacing: -.02em; }
  .process-step p { margin: 0; color: rgba(255,255,255,.7); line-height: 1.7; font-size: .95rem; }
  .process-step code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .92em; padding: .12rem .4rem; border-radius: 8px; background: rgba(255,255,255,.07); }
  .process-visual { min-width: 0; }
  .process-stage { position: relative; width: 100%; aspect-ratio: 1 / 1; max-height: 72vh; margin-inline: auto; }
  .process-frame {
    position: absolute; inset: 0; width: 100%; height: 100%; border: 0; background: transparent;
    opacity: 0; transform: scale(.965) translateY(10px); transition: opacity .5s ease, transform .55s ease;
    pointer-events: none;
  }
  .process-frame.is-active { opacity: 1; transform: scale(1) translateY(0); }
  .faq-list { display: grid; gap: .8rem; }
  .faq-list details { padding: 1rem 1.1rem; }
  .faq-list summary { cursor: pointer; font-weight: 600; list-style: none; position: relative; padding-right: 1.5rem; }
  .faq-list summary::-webkit-details-marker { display: none; }
  .faq-list summary::after { content: '+'; position: absolute; right: 0; top: 0; color: var(--mint); font-weight: 700; }
  .faq-list details[open] summary::after { content: '–'; }
  .faq-list p { margin-top: .7rem; }
  .site-footer { padding: 2.5rem 0 3rem; border-top: 1px solid rgba(255,255,255,.08); }
  .footer-inner { display: flex; justify-content: space-between; gap: 1.5rem; align-items: end; }
  .site-footer img { height: 38px; width: auto; margin-bottom: .75rem; }
  .footer-links { display: flex; gap: 1rem; flex-wrap: wrap; }
  .footer-links a { color: rgba(255,255,255,.68); font-size: .9rem; }
  .footer-links a:hover { color: #fff; }
  @media (max-width: 900px) {
    .steps-grid, .privacy-grid, .faq-grid, .process-layout { grid-template-columns: 1fr; }
    .section-title { max-width: 100%; }
    .process-pin { height: 280vh; }
    .process-sticky { padding: 5.5rem 0 2rem; align-items: start; }
    .process-layout { gap: 1.5rem; }
    .process-copy .section-title { margin-bottom: 1rem; }
    .process-stage { max-height: 52vh; }
    .process-step { padding: .75rem 0 .75rem .9rem; gap: .75rem; }
    .process-step h3 { font-size: 1.1rem; }
    .process-step p { font-size: .88rem; line-height: 1.55; }
    .footer-inner { flex-direction: column; align-items: flex-start; }
  }
</style>
